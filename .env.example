# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM provider selection ---
# Which provider ask.py calls by default: "gemini" or "groq"
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Database (matches docker-compose.yml — change only if you edit that file too) ---
DATABASE_URL=postgresql://kf_user:kf_password@localhost:5432/knowledgeforge

# --- Retrieval tuning ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# --- Observability (Phase 3, optional) ---
# Leave blank to skip Langfuse -- confirmed safe, tracing just silently no-ops.
# Free account: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Evaluation (Phase 3) ---
# eval.py exits non-zero if avg faithfulness drops below this.
EVAL_FAITHFULNESS_THRESHOLD=0.7

# --- Cost & latency optimization (Phase 4) ---
# Redis matches docker-compose.yml -- change only if you edit that file too.
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES=200

# Ollama runs natively, not in Docker (see README) -- default matches its
# standard local install. Only matters if you set up local routing.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Rough estimate used only to make the benchmark's "$ saved" number concrete.
EST_COST_PER_CLOUD_CALL_USD=0.0006

# --- API (Phase 5) ---
# Leave blank for local dev (auth disabled). Set a real value before this
# is reachable off your own machine.
API_KEY=
