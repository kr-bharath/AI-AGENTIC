# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM provider selection ---
# Which provider ask.py calls by default: "gemini" or "groq"
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Database (matches docker-compose.yml — change only if you edit that file too) ---
DATABASE_URL=postgresql://kf_user:kf_password@localhost:5432/knowledgeforge

# --- Retrieval tuning ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
